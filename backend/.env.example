PORT=5000
CORS_ORIGIN=http://localhost:3000

# Supabase is the primary database provider. Never commit real values.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_HEALTH_TIMEOUT_MS=8000

# Supabase Auth accounts are stored in auth.users. Listed emails receive
# administrator permissions; all other authenticated users are view-only.
AUTH_ADMIN_EMAILS=
AUTH_SUPERADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=
